# Environment
.env
.env.*

# Virtual environment
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Data cache (ephemeral — regenerated each session)
logs/data_cache/

# Scan packets (stored in Supabase; local copies are disposable)
logs/predictions/scan_*.json

# Account state (fetched via MCP each session — not persisted to git)
logs/account_state.json

# Keep directory structure
!logs/.gitkeep
!logs/data_cache/.gitkeep
!logs/predictions/.gitkeep
!logs/reviews/.gitkeep

# OS
.DS_Store
Thumbs.db
